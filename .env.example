# Next.js Environment Variables
# Copia este archivo a .env.local y completa los valores

# URL base del sitio (para meta tags y SEO)
NEXT_PUBLIC_SITE_URL=https://yosephprieto.com

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-here-generate-with-openssl-rand-base64-32

# Admin Authentication
# UUID fijo para acceso administrativo (debe estar en la URL)
ADMIN_UUID=24f901ff-e665-44d4-9d9f-28c8ee059501

# Email del administrador (debe coincidir con el usuario creado en Supabase Auth)
# La contraseña se configura en Supabase Auth, no aquí
ADMIN_EMAIL=admin@yosephprieto.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Otros servicios opcionales
# NEXT_PUBLIC_API_URL=
